# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-oder-publishable-key
# Geheim! Nur auf dem Server (Vercel-Umgebungsvariable), nie im Browser
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-oder-secret-key

# OpenAI – geheim, nur auf dem Server
OPENAI_API_KEY=sk-...
# Optional: Modelle überschreiben
# OPENAI_MODEL=gpt-5.5
# OPENAI_MODEL_FAST=gpt-5.4-mini

# Nur für Tests: simulierte KI statt OpenAI
# AI_MOCK=1
